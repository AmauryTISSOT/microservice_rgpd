<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Banc jetable : passe les relevés RÉELLEMENT produits par les conteneurs dans
    l'ingestion RÉELLE du service, plutôt que de conclure par lecture du parseur.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AssemblyName>Verdict</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/MicroserviceRgpd.Core/MicroserviceRgpd.Core.csproj" />
  </ItemGroup>

</Project>
