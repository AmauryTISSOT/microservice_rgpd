<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.1.3" />

  <ItemGroup>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!--
      ⚠️ Le pilote SQLite est ici pour ÉCRIRE la base de fixture du canari à cinq surfaces, jamais
      pour la lire : c'est le service, par son vrai port de scan, qui la lit.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!--
    Les sorties RÉELLEMENT produites par les requêtes de `releves/`, jouées sur de vrais
    SGBD en conteneur. Embarquées depuis `exploration/releves-authentiques/` plutôt que
    recopiées ici : une fixture rédigée à la main dirait ce que son auteur croit que la
    requête produit, et c'est très exactement l'angle mort qui a laissé passer #284.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\exploration\releves-authentiques\captures\postgresql.txt"
                      LogicalName="releve-postgresql.txt" />
    <EmbeddedResource Include="..\..\exploration\releves-authentiques\captures\mysql84.txt"
                      LogicalName="releve-mysql84.txt" />
    <EmbeddedResource Include="..\..\exploration\releves-authentiques\captures\mariadb118.txt"
                      LogicalName="releve-mariadb118.txt" />
    <EmbeddedResource Include="..\..\exploration\releves-authentiques\captures\sqlite.txt"
                      LogicalName="releve-sqlite.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MicroserviceRgpd.Infrastructure\MicroserviceRgpd.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MicroserviceRgpd.UseCases\MicroserviceRgpd.UseCases.csproj" />
    <ProjectReference Include="..\..\src\MicroserviceRgpd.Web\MicroserviceRgpd.Web.csproj" />
    <ProjectReference Include="..\MicroserviceRgpd.TestDoubles\MicroserviceRgpd.TestDoubles.csproj" />
  </ItemGroup>

</Project>
