<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Projet volontairement vide, et il doit le rester.

    Tout test démarrant l'AppHost démarrerait aussi le sidecar de qualification et le container
    Ollama : il exigerait un GPU, ne tournerait donc jamais sur la machine du développeur ni en
    CI — et un test qui ne tourne jamais ment. La frontière est posée sur IQualificationEngine,
    doublé avec NSubstitute dans UnitTests et FunctionalTests.

    Ni référence à l'AppHost, ni Aspire.Hosting.Testing : les rétablir rouvrirait le piège.
    La seule exception est OllamaWiring.cs, compilé par lien dans UnitTests : il ne dépend d'aucun
    type d'Aspire et ne construit aucun hôte. Le jour où il en réclamerait un, c'est la décision
    qui sort du fichier vers un endroit sans Aspire, jamais la référence qui revient.
    Une vérification d'orchestration complète, si elle voit le jour, sera un dispositif manuel
    séparé et une décision à part.
  -->

  <PropertyGroup>
    <!-- TargetFramework, ImplicitUsings et Nullable viennent de Directory.Build.props -->
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

</Project>
