    <!-- Pins transitifs : corrigent des vulnerabilites remontees par NuGet audit -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!--
      SSH.NET : tire transitivement par Testcontainers 4.13.0, qui exige encore 2025.1.0,
      vulnerable (GHSA-q939-rpr3-3284, severite haute, corrigee en 2026.0.0).
      A retirer des que Testcontainers publie une version dependant de SSH.NET >= 2026.0.0.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!--
      SQLitePCLRaw.lib.e_sqlite3 : la bibliotheque native tiree transitivement par
      Microsoft.Data.Sqlite 10.0.10, qui exige encore 2.1.11, vulnerable
      (GHSA-2m69-gcr7-jv3q, severite haute, corrigee en 2.1.12).
      A retirer des que Microsoft.Data.Sqlite dependra de SQLitePCLRaw >= 2.1.12.
    -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>
