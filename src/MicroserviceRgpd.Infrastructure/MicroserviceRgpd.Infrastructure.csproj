<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Microsoft.Build.CentralPackageVersions" Version="2.1.3" />

  <ItemGroup>
    <PackageReference Include="Ardalis.SharedKernel" />
    <PackageReference Include="Ardalis.Specification.EntityFrameworkCore" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="MailKit" />
    <!-- Le pilote du dialecte SQLite du IDatabaseScanner (#304). Il embarque SQLitePCLRaw, dont
         sqlite3_interrupt est ce qui coupe une requête en cours quand l'Operator quitte l'écran. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Le pilote du dialecte MariaDB/MySQL du IDatabaseScanner (#307). MIT, asynchrone pour de
         vrai, et il coupe la requete en cours sur annulation. MySql.Data est ecarte : licence GPL
         a exception, et un asynchrone qui bloque le fil sous le capot. -->
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" 
                      ExcludeAssets="contentFiles" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <!-- Le pipeline de resilience explicite des deux clients de moteur, qui remplace le pipeline
         standard applique par defaut a tous les clients HTTP du depot. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="NimblePros.Metronome" />
    <PackageReference Include="Vogen" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Les lexiques gelés du banc de détection (commit d413d55), embarqués dans l'assemblage : le
         moteur démarre avec le service et ne lit aucun fichier du disque. Les rééditer est interdit
         (#155) — FrozenLexiconsTests ancre leur empreinte. -->
    <EmbeddedResource Include="Screenings\Lexicons\*.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le texte des requêtes embarquées du scanner se relit en test — c'est la moitié « filet de
         sécurité sans conteneur » de #304 —, et le rendre public pour cela ferait d'un détail de
         pilote une surface d'assemblage. -->
    <InternalsVisibleTo Include="MicroserviceRgpd.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicroserviceRgpd.Core\MicroserviceRgpd.Core.csproj" />
    <ProjectReference Include="..\MicroserviceRgpd.UseCases\MicroserviceRgpd.UseCases.csproj" />
  </ItemGroup>
</Project>
