{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  // La chaine de connexion PostgreSQL est injectee par CustomWebApplicationFactory (Testcontainers).
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  // Le secret d Adapter des tests fonctionnels : sans lui, l hote ne demarrerait pas. Aucun test
  // ne l envoie a un vrai Adapter — les tests du contrat posent leur doublure sur le fil.
  "Casework": {
    "AdapterSecret": "secret-de-developpement-jamais-un-vrai"
  }
}
