{
  "ConnectionStrings": {
    // Sous Aspire, la chaine est fournie automatiquement par l AppHost (cle "cleanarchitecture").
    // Decommenter pour lancer le projet Web seul contre un PostgreSQL local :
    //"DefaultConnection": "Host=localhost;Port=5432;Database=cleanarchitecture;Username=postgres;Password=postgres"
  },
  "Database": {
    // Set to true to apply migrations on startup (useful for containerized environments)
    // By default, migrations run automatically in Development environment
    "ApplyMigrationsOnStartup": false
  },
  "Qualification": {
    // Le nom du service, non une machine : Aspire le resout. En dehors d Aspire, remplacer par
    // l adresse du sidecar lance a la main (uvicorn ecoute par defaut sur http://localhost:8000).
    // Seule source de verite : le code n a aucun repli, et son absence arrete le demarrage.
    //
    // Le prefixe « https+http » enonce une PREFERENCE de schema, pas un schema : la decouverte de
    // services prend l endpoint https du sidecar s il existe, son endpoint http sinon. Ecrire
    // « http:// » seul exigerait un endpoint http, et Aspire n en publie pas — il lance uvicorn
    // avec --ssl-certfile, donc en https seul. La resolution echouait alors sans bruit, le nom
    // partait tel quel au DNS, et les deux moteurs tombaient ensemble sur « hote inconnu » : une
    // double panne, donc un 503, pour une simple lettre manquante.
    "SidecarBaseAddress": "https+http://qualification-sidecar",

    // Les deux echeances des clients de moteur, en secondes. Aucune n a ete mesuree : elles sont
    // arbitraires et assumees, et devront etre revisees le jour ou le modele tournera sous charge.
    // Sous Aspire, l AppHost les remplace toutes deux — c est lui qui tient l echeance du sidecar
    // vers Ollama, et donc le seul a pouvoir garantir que celle-ci reste la plus courte.
    //
    // L echeance du LLM doit rester strictement plus longue que celle du sidecar vers son amont
    // (120 s) : c est cet ecart qui fait que le sidecar abandonne le premier et sait nommer la
    // lenteur, la ou le client .NET n aurait qu une annulation muette a rapporter.
    "LlmDeadlineSeconds": 150,

    // Franchement plus courte, au point que le temoin ne puisse jamais rallonger le temps de
    // reponse du service. Au-dela, son avis est traite comme absent.
    "LexiconDeadlineSeconds": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
        {
            "Name": "Console"
        }
        // uncomment if you want file logging
        //,
        //{
        //  "Name": "File",
        //  "Args": {
        //    "path": "log.txt",
        //    "rollingInterval": "Day"
        //  }
        //}

        //Uncomment this section if you'd like to push your logs to Azure Application Insights
        //Full list of Serilog Sinks can be found here: https://github.com/serilog/serilog/wiki/Provided-Sinks
        //{
        //  "Name": "ApplicationInsights",
        //  "Args": {
        //    "instrumentationKey": "", //Fill in with your ApplicationInsights InstrumentationKey
        //    "telemetryConverter": "Serilog.Sinks.ApplicationInsights.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        //  }
        //}
    ]
  },
  "Mailserver": {
    "Server": "localhost",
    "Port": 25
  }
}
