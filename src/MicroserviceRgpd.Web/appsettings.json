{
  "ConnectionStrings": {
    // Sous Aspire, la chaine est fournie automatiquement par l AppHost (cle "cleanarchitecture").
    // Decommenter pour lancer le projet Web seul contre un PostgreSQL local :
    //"DefaultConnection": "Host=localhost;Port=5432;Database=cleanarchitecture;Username=postgres;Password=postgres"
  },
  "Database": {
    // Set to true to apply migrations on startup (useful for containerized environments)
    // By default, migrations run automatically in Development environment
    "ApplyMigrationsOnStartup": false
  },
  "Qualification": {
    // Le nom du service, non une machine : Aspire le resout. En dehors d Aspire, remplacer par
    // l adresse du sidecar lance a la main (uvicorn ecoute par defaut sur http://localhost:8000).
    // Seule source de verite : le code n a aucun repli, et son absence arrete le demarrage.
    //
    // Le prefixe « https+http » enonce une PREFERENCE de schema, pas un schema : la decouverte de
    // services prend l endpoint https du sidecar s il existe, son endpoint http sinon. Ecrire
    // « http:// » seul exigerait un endpoint http, et Aspire n en publie pas — il lance uvicorn
    // avec --ssl-certfile, donc en https seul. La resolution echouait alors sans bruit, le nom
    // partait tel quel au DNS, et les deux moteurs tombaient ensemble sur « hote inconnu » : une
    // double panne, donc un 503, pour une simple lettre manquante.
    "SidecarBaseAddress": "https+http://qualification-sidecar",

    // L echeance du client lexical, en secondes. Requise dans tous les cas, LLM allume ou eteint :
    // le lexique vit dans ce meme sidecar, et eteindre le moteur generatif ne retire pas cette
    // dependance. Franchement plus courte que celle du LLM, au point que le temoin ne puisse jamais
    // rallonger le temps de reponse du service. Au-dela, son avis est traite comme absent.
    // Arbitraire et assumee : elle n a pas ete mesuree.
    "LexiconDeadlineSeconds": 5,

    // Les reglages propres au moteur LLM. Section absente, ou drapeau absent : le moteur est
    // ETEINT, et le role Verdict n est alors pourvu par rien — ni client, ni pipeline, ni entree
    // dans le conteneur. Le service qualifie quand meme, sur le seul lexique, en mode degrade.
    //
    // C est le seul reglage de cette section a disposer d un repli, et l ecart a la doctrine du
    // depot est delibere : un deploiement qui ne dit rien ne soumet jamais le texte d une personne
    // concernee a un modele generatif, et le depot se clone et se demarre sans materiel.
    //
    // Sous Aspire, l AppHost pose ces deux valeurs par variable d environnement : c est lui qui
    // tient l echeance du sidecar vers Ollama, donc le seul a pouvoir garantir que celle-ci reste
    // la plus courte. Hors Aspire — le seul projet Web lance a la main contre un sidecar local —,
    // ce fichier fait foi : le service tourne SANS LLM par defaut. Qui le veut dans ce mode doit
    // l ecrire, ici et cote sidecar (QUALIFICATION_LLM_ENABLED), les deux moities ne partageant
    // alors plus aucune source commune.
    "Llm": {
      "Enabled": false,

      // Lue seulement moteur allume. Allume sans elle : refus au demarrage. Eteint avec elle : elle
      // est ignoree sans bruit, ce qui permet de rallumer sans recomposer ces reglages.
      // Elle doit rester strictement plus longue que l echeance du sidecar vers son amont (120 s) :
      // c est cet ecart qui fait que le sidecar abandonne le premier et sait nommer la lenteur, la
      // ou le client .NET n aurait qu une annulation muette a rapporter.
      "DeadlineSeconds": 150
    }
  },
  "Screening": {
    // Le moteur de detection A2 (ADR-0025). Section absente, ou drapeau absent : il est ETEINT, et
    // c est le lexique qui detecte — la pile demarre sans GPU, sans telechargement et sans Ollama.
    // Toute valeur autre que true ou false arrete le demarrage.
    //
    // Un seul moteur par deploiement, et aucun repli a l execution : allume et Ollama injoignable,
    // aucun rapport de detection n est produit, et le lexique ne detecte jamais a sa place.
    //
    // Le seuil, l encodeur, son digest et le gabarit ne se reglent PAS ici : ils vivent dans le
    // manifest de l artefact embarque, et nulle part ailleurs.
    "Embeddings": {
      "Enabled": false,

      // Lues seulement moteur allume. Allume sans elles : refus au demarrage. Eteint avec elles :
      // ignorees sans bruit.
      "OllamaBaseAddress": "http://localhost:11434",

      // L echeance d UN appel a Ollama — un lot de 64 colonnes, ou la lecture de /api/tags.
      // Arbitraire et assumee : elle n a pas ete mesuree.
      "DeadlineSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
        {
            "Name": "Console"
        }
        // uncomment if you want file logging
        //,
        //{
        //  "Name": "File",
        //  "Args": {
        //    "path": "log.txt",
        //    "rollingInterval": "Day"
        //  }
        //}

        //Uncomment this section if you'd like to push your logs to Azure Application Insights
        //Full list of Serilog Sinks can be found here: https://github.com/serilog/serilog/wiki/Provided-Sinks
        //{
        //  "Name": "ApplicationInsights",
        //  "Args": {
        //    "instrumentationKey": "", //Fill in with your ApplicationInsights InstrumentationKey
        //    "telemetryConverter": "Serilog.Sinks.ApplicationInsights.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        //  }
        //}
    ]
  },
  "Mailserver": {
    "Server": "localhost",
    "Port": 25
  }
}
