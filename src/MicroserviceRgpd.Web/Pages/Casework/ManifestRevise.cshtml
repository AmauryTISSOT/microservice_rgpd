@page "/manifest/{id}"
@model ManifestReviseModel
@using System.Globalization
@{
  ViewData["Title"] = "Reprendre une déclaration";
}

<h1>Reprendre une déclaration</h1>

<p class="caveat">
  Ce que vous écrivez ici <strong>redate ce système au jour d'aujourd'hui</strong> : la date dit la
  fraîcheur de l'affirmation, non l'ancienneté de la ligne. Il était déclaré le
  @Model.DeclaredOn.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture).
</p>

@if (!ViewData.ModelState.IsValid)
{
  <div class="refusals">
    @foreach (var refusal in ViewData.ModelState.Values.SelectMany(entry => entry.Errors))
    {
      <p class="refusal">@refusal.ErrorMessage</p>
    }
  </div>
}

<form method="post">
  <p>
    <label for="id">
      Identifiant
      <span class="hint">
        Il ne se réécrit pas : c'est ce que votre Adapter connaît de ce système.
      </span>
    </label>
    <input type="text" id="id" value="@Model.Id" disabled />
  </p>

  <partial name="_DeclaredSystemFields" model="Model.Form" />

  <button type="submit" class="primary">Reprendre cette déclaration</button>
</form>

<p><a asp-page="Manifest">Revenir à « Configuration »</a></p>
