@page "/dossiers/{id:guid}"
@model CaseModel
@using System.Globalization
@using MicroserviceRgpd.Core.Casework
@{
  ViewData["Title"] = "Le dossier";
  var onScreen = Model.OnScreen!;
}

<h1>Le dossier</h1>

@*
  Le bandeau. Il nomme la plus ancienne déclaration du Manifest parmi les systèmes de ce dossier :
  c'est au moment où quelqu'un signe qu'une déclaration vieille doit lui être rappelée.
*@
<dl class="banner">
  <dt>Identifiant</dt>
  <dd>@onScreen.Case.Value</dd>

  @*
    Pas de ligne « État » : elle ne pourrait dire qu'« ouvert », faute de clôture, et un bandeau qui
    affiche une valeur incapable de varier apprend à ne plus le lire. Elle reviendra avec la clôture,
    quand elle dira quelque chose.
  *@
  <dt>Identité déclarée</dt>
  <dd>@onScreen.IdentityDeclaration.FrenchLabel</dd>

  @*
    LA MOTIVATION, ET SES DEUX MOITIÉS. La méthode se compte et survit au dossier ; le détail nomme
    par nature et meurt à la clôture. L'écran est le seul endroit où les deux se lisent ensemble.
  *@
  <dt>Motivation de l'identité</dt>
  <dd>
    @if (onScreen.Motivation is { } motivation)
    {
      <span class="method">@motivation.Method.FrenchLabel</span>
      @if (motivation.Detail is { } detail)
      {
        <span class="hint">
          @detail
          <br />
          Ce détail vit sur ce dossier et <strong>disparaît à sa clôture</strong> ; seule la méthode
          survit dans la matière de preuve.
        </span>
      }
    }
    else if (onScreen.AwaitsAMotivation)
    {
      @*
        L'EXIGENCE NON SATISFAITE, ET ELLE RESTE AFFICHÉE. Le dossier est ouvert, le délai court, et
        rien n'est barré : la faiblesse doit rester VISIBLE plutôt que contournée. Un refus à
        l'entrée l'aurait fait disparaître — soit en renvoyant la personne à son silence, soit en
        faisant cocher n'importe quoi.
      *@
      <strong class="claimed-motivation">Motivation réclamée.</strong>
      <span class="hint">
        Un <code>Access</code> s'est ouvert ici sous une identité qui ne repose sur aucun contrôle du
        canal, et <strong>personne n'a pesé</strong> ce que cela valait. Le dossier s'instruit quand
        même ; cette ligne restera tant qu'aucune méthode n'aura été déclarée.
      </span>

      @*
        LA DEMANDE PEUT ÊTRE SATISFAITE, et c'est ce qui la rend lisible : une exigence qu'on ne peut
        pas satisfaire cesse d'être lue, et le bandeau qu'on apprend à ne plus voir aurait rendu la
        faiblesse invisible — l'inverse exact de ce qu'il est là pour faire.

        ⚠️ Ce qui s'écrit ici ne touche AUCUN droit : l'accès ouvert lundi garde l'identité sous
        laquelle il est né. La preuve gardera les deux dates, et l'écart entre elles est un fait.
      *@
      <form method="post" asp-page-handler="Motivate">
        <fieldset class="signature">
          <legend>Peser cette identité maintenant</legend>

          <p class="hint">
            Ce que vous écrivez ici dit ce que vous avez <strong>fini par</strong> peser. Le droit
            déjà ouvert garde l'identité sous laquelle il est né : la preuve gardera les deux dates,
            et rien de ce geste ne rend rétroactivement propre ce qui a été fait avant lui.
          </p>

          <p>
            <label for="motivation-method">Méthode</label>
            <span class="hint">
              Fermée, parce qu'elle <strong>se compte et survit au dossier</strong>. <em>Aucune</em>
              en fait partie : c'est la réponse de qui a regardé et n'a rien fait.
            </span>
            <select id="motivation-method" name="Motivation.VerificationMethod">
              @*
                Aucune option vide ici, à la différence du dépôt : le vide y disait « personne n'a
                encore pesé », et quelqu'un est en train de peser — c'est le geste même.
              *@
              @foreach (var method in IdentityVerificationMethod.List.OrderBy(one => one.Value))
              {
                <option value="@method.Name"
                        selected="@(method.Name == Model.Motivation.VerificationMethod)">
                  @method.FrenchLabel
                </option>
              }
            </select>
          </p>

          <p>
            <label for="motivation-detail">Détail</label>
            <span class="hint">
              En prose libre, et <strong>facultatif</strong>. Il nomme par nature, vit sur ce dossier
              et <strong>disparaît à sa clôture</strong>. Rien de ce champ n'entre dans la preuve.
            </span>
            <textarea id="motivation-detail"
                      name="Motivation.Detail"
                      rows="3"
                      maxlength="@IdentityMotivation.MaxDetailLength">@Model.Motivation.Detail</textarea>
          </p>

          <p>
            <label for="motivation-signedby">
              Votre nom
              <span class="hint">
                Saisi, et <strong>non authentifié</strong> : la preuve garde votre nom <em>et</em> ce
                régime.
              </span>
            </label>
            <input type="text"
                   id="motivation-signedby"
                   name="Motivation.SignedBy"
                   maxlength="@MicroserviceRgpd.Core.Casework.Ledger.Signatory.MaxNameLength" />
          </p>

          <button type="submit">Déclarer et signer</button>
        </fieldset>
      </form>
    }
    else
    {
      <span class="none">Aucune n'est réclamée pour ce dossier.</span>
    }
  </dd>

  <dt>Reçu le</dt>
  <dd>
    @if (onScreen.Reception.IsDefault)
    {
      @*
        Le défaut se nomme comme un défaut : on affiche la règle appliquée, jamais la date qu'elle a
        produite, qui se lirait comme un fait que personne n'a déclaré.
      *@
      <span class="defaulted">J+@ReceptionDate.DaysHeldAlreadyRunByDefault (défaut)</span>
      <span class="hint">Personne n'a déclaré cette date ; le service tient ce nombre de jours pour déjà courus.</span>
    }
    else
    {
      @onScreen.Reception.On.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
    }
  </dd>

  <dt>Échéance (art. 12.3)</dt>
  <dd>
    @onScreen.Deadline.On.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)
    @if (onScreen.DelayOverrun)
    {
      <strong class="overrun">délai dépassé</strong>
    }
  </dd>

  <dt>Paysage déclaré</dt>
  <dd>
    @if (onScreen.OldestStepDeclaration is { } oldest)
    {
      <text>
        La plus ancienne déclaration des systèmes de ce dossier date du
        @oldest.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture).
      </text>
    }
    else
    {
      <span class="none">Aucun système n'était déclaré quand ce dossier s'est ouvert.</span>
    }
    <span class="hint">
      Ce recensement est déclaré à la main et <strong>ne garantit pas qu'il n'en existe pas
      d'autres</strong>.
    </span>
  </dd>
</dl>

@if (!ViewData.ModelState.IsValid)
{
  <div class="refusals">
    @foreach (var refusal in ViewData.ModelState.Values.SelectMany(entry => entry.Errors))
    {
      <p class="refusal">@refusal.ErrorMessage</p>
    }
  </div>
}

<h2>Le travail dû</h2>

@if (onScreen.Claims.Count == 0)
{
  @* Un dossier sans réclamation est un fait, jamais une saisie inachevée. *@
  <p class="none">Aucun droit n'est reconnu à ce dossier à ce jour.</p>
}

@foreach (var claim in onScreen.Claims)
{
  <div class="claim">
    <h3>@claim.Right.Name <span class="hint">— @claim.State.FrenchLabel</span></h3>

    @*
      L'origine et l'identité D'ORIGINE, et non celles du dossier d'aujourd'hui : un droit garde la
      porte sous laquelle il est né, et une déclaration relevée plus tard ne réécrit pas la preuve
      d'hier.
    *@
    <p class="hint">
      @claim.Origin.FrenchLabel — ouvert sous l'identité « @claim.IdentityAtOrigin.FrenchLabel ».
      @if (claim.IdentityAtOrigin != onScreen.IdentityDeclaration)
      {
        <text>
          Le dossier déclare aujourd'hui « @onScreen.IdentityDeclaration.FrenchLabel » ; ce droit
          garde <strong>celle sous laquelle il s'est ouvert</strong>.
        </text>
      }
    </p>

    @if (claim.AwaitsConfirmation)
    {
      @*
        UNE OpenQuestion, JAMAIS UN BLOCAGE. Le droit est dans le dossier, le travail dû existe, le
        délai court : l'attente est visible ICI plutôt que rangée dans un vestibule que personne ne
        regarde. Il n'existe aucun état d'attente hors du Case.
      *@
      <p class="claimed-confirmation">
        <strong>Confirmation réclamée.</strong> Une <code>Qualification</code> a proposé ce droit ;
        aucun humain ne l'a encore repris à son compte. Le dossier s'instruit quand même — le délai
        de l'art. 12.3 ne s'arrête pour personne — mais la preuve dira qu'aucune personne ne l'a
        reconnu tant que cette ligne est là.
      </p>

      <form method="post" asp-page-handler="Confirm">
        <input type="hidden" name="Confirmation.Right" value="@claim.Right.Name" />

        <fieldset class="signature">
          <legend>Reprendre ce droit à mon compte</legend>

          <p>
            <label for="confirm-signedby-@claim.Right.Name">
              Votre nom
              <span class="hint">
                Saisi, et <strong>non authentifié</strong> : la preuve garde votre nom <em>et</em> ce
                régime.
              </span>
            </label>
            <input type="text"
                   id="confirm-signedby-@claim.Right.Name"
                   name="Confirmation.SignedBy"
                   maxlength="@MicroserviceRgpd.Core.Casework.Ledger.Signatory.MaxNameLength" />
          </p>

          <button type="submit">Confirmer et signer</button>
        </fieldset>
      </form>
    }

    @if (claim.MotivationIsDemanded && onScreen.Motivation is null)
    {
      @*
        Redite au grain du droit : le bandeau dit que le dossier réclame une motivation, cette ligne
        dit LEQUEL des droits l'exige. Sans elle, un dossier portant Access et Erasure laisserait
        chercher lequel des deux est en cause.
      *@
      <p class="claimed-motivation">
        <strong>Motivation réclamée pour ce droit.</strong> Un accès accordé à un imposteur ne doit
        pas passer sans que quiconque l'ait pesé.
      </p>
    }

    @if (claim.Steps.Count == 0)
    {
      <p class="none">
        Aucun système n'était déclaré quand ce dossier s'est ouvert : ce droit ne porte aucun travail
        dû, et ce n'est pas un travail achevé.
      </p>
    }

    @foreach (var step in claim.Steps)
    {
      <div class="step">
        <h4>
          @(step.Label?.Value ?? step.DeclaredSystem.Value)
          <span class="hint">— @step.State.FrenchLabel</span>
        </h4>

        <p class="hint">
          @step.DeclaredSystem.Value
          @if (step.DeclaredOn is { } declaredOn)
          {
            @* La date du Manifest descend jusqu'ici : elle se lit là où quelqu'un signe. *@
            <text>— déclaré le @declaredOn.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</text>
          }
          else
          {
            <text>— ce système ne figure plus au catalogue ; le travail reste dû.</text>
          }
        </p>

        @if (step.AwaitsAFinding)
        {
          @*
            Le constat réclamé sur un « fait » dont le service ne détient aucun rattachement. Aucun
            état nouveau : un sixième état de Step aurait fait porter au dossier une exigence de la
            surface, et il aurait fallu le faire retomber quelque part.
          *@
          <p class="claimed-finding">
            <strong>Constat réclamé.</strong> Ce travail est déclaré fait sans qu'aucun rattachement
            ne soit détenu par le service : dites ce qui a été cherché et sous quoi, pour qu'un zéro
            ne se lise pas « cette personne n'est pas chez nous ».
          </p>
        }

        @*
          Sur un refus, la saisie revient — mais seulement dans le formulaire d'où elle vient : la
          prose d'un constat recopiée dans les cinq autres formulaires de l'écran ferait signer sur un
          système la phrase écrite pour un autre. Une prose refusée pour un nom vide ne doit pas être à
          réécrire : c'est le travail de l'Operator, pas une saisie jetable.
        *@
        @{
          var submitted = Model.Form.Right == claim.Right.Name
            && Model.Form.DeclaredSystem == step.DeclaredSystem.Value;
        }

        <form method="post">
          <input type="hidden" name="Form.Right" value="@claim.Right.Name" />
          <input type="hidden" name="Form.DeclaredSystem" value="@step.DeclaredSystem.Value" />

          <p>
            <label for="state-@claim.Right.Name-@step.DeclaredSystem.Value">Déclarer l'état</label>
            <select id="state-@claim.Right.Name-@step.DeclaredSystem.Value" name="Form.State">
              @foreach (var state in StepState.List.OrderBy(one => one.Value))
              {
                @* « Non traité » est offert comme les autres : sans la valeur laide, on coche la propre. *@
                <option value="@state.Name"
                        selected="@(state.Name == (submitted ? Model.Form.State : step.State.Name))">
                  @state.FrenchLabel
                </option>
              }
            </select>
          </p>

          @*
            LA SIGNATURE. Le constat — prose de PREUVE — se saisit ici, au point de décision, avec le
            nom : il entre dans le Ledger et survit à la clôture. La prose de TRAVAIL a son propre
            endroit, plus bas, et n'entre jamais dans la preuve. La règle tient par ce placement.
          *@
          <fieldset class="signature">
            <legend>Signer ce constat</legend>

            <p>
              <label for="finding-@claim.Right.Name-@step.DeclaredSystem.Value">
                Constat
                <span class="hint">
                  Ce qui a été fait, ou ce qui ne l'a pas été. Ce texte <strong>entre dans la matière
                  de preuve et survit au dossier</strong> : il dit pourquoi vous avez déclaré cela, et
                  ne nomme personne.
                </span>
              </label>
              <textarea id="finding-@claim.Right.Name-@step.DeclaredSystem.Value"
                        name="Form.Finding"
                        rows="3"
                        maxlength="@MicroserviceRgpd.Core.Casework.Ledger.LedgerEntry.MaxEvidenceProseLength">@(submitted ? Model.Form.Finding : null)</textarea>
            </p>

            <p>
              <label for="signedby-@claim.Right.Name-@step.DeclaredSystem.Value">
                Votre nom
                <span class="hint">
                  Saisi, et <strong>non authentifié</strong> : la preuve garde votre nom
                  <em>et</em> ce régime, pour qu'elle ne soit pas relue comme une identification.
                </span>
              </label>
              @*
                Le nom, lui, ne revient jamais — pas même sur un refus. Il coûte peu à retaper, et une
                case vide fait de chaque envoi qui écrit un geste délibéré : c'est la seule case dont le
                remplissage automatique ferait signer quelqu'un sans qu'il l'ait voulu.
              *@
              <input type="text"
                     id="signedby-@claim.Right.Name-@step.DeclaredSystem.Value"
                     name="Form.SignedBy"
                     maxlength="@MicroserviceRgpd.Core.Casework.Ledger.Signatory.MaxNameLength" />
            </p>

            <button type="submit">Déclarer et signer</button>
          </fieldset>
        </form>
      </div>
    }
  </div>
}

<h2>La prose de travail</h2>

@*
  Le SECOND endroit, et il est délibérément séparé du premier. Ce qui se lit ici dit quelle ligne
  appartient à qui, nomme donc par nature des tiers non demandeurs, vit sur le dossier et MEURT à la
  clôture — le Ledger n'en garde que le fait daté. Aucun champ de cette section n'a de chemin vers la
  preuve, et c'est ce placement, et non la discipline de l'Operator, qui tient la règle.
*@
<p class="caveat">
  Ce qui se lit ici vit sur le dossier et <strong>disparaît à sa clôture</strong> : les réserves d'un
  <code>Locate</code> et les questions posées, qui nomment par nature. Rien de cette section n'entre
  dans la matière de preuve.
</p>

@*
  LES QUESTIONS OUVERTES. On affiche la date à laquelle la question a été posée, JAMAIS « sans
  réponse depuis N jours » : aucun nombre du droit ne fonde N, un seuil réglable serait une case à
  laisser pourrir, et trier sur lui ferait passer devant un compteur sans force juridique.
*@
@foreach (var question in onScreen.Questions)
{
  <p class="open-question">
    <strong>Question ouverte — @question.Subject.FrenchLabel</strong>, posée le
    @question.AskedOn.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture).
    <span class="hint">
      Tous les <code>Locate</code> de ce dossier ont rendu <strong>zéro rattachement</strong>. Cela ne
      veut pas dire que cette personne n'est pas chez le client : un <code>Locate</code> ne distingue
      pas « cherché, aucun rattachement » de « désignation insuffisante ». Le délai de l'art. 12.3
      <strong>continue de courir</strong> — rien ne l'arrête, et cette question ne barre rien.
    </span>
  </p>
}

<h3>Où l'on cherche la personne</h3>

@if (onScreen.Locatings.Count == 0)
{
  <p class="none">
    Aucun système du catalogue ne déclare à la fois une adresse d'<code>Adapter</code> et la capacité
    <code>Locate</code> : le service n'a appelé personne, et ce recensement se traite à la main.
  </p>
}

@foreach (var located in onScreen.Locatings)
{
  <div class="locating">
    <h4>@(located.Label?.Value ?? located.DeclaredSystem.Value)</h4>

    <p class="hint">@located.DeclaredSystem.Value</p>

    @if (located.Locating is not { } locating)
    {
      @*
        « Pas appelé » et « appelé, rien trouvé » sont DEUX déclarations différentes, et seule la
        seconde a une valeur de preuve. L'écran ne les confond pas : un zéro affiché ici pour un
        système muet serait un constat que personne n'a fait.
      *@
      <p class="none">
        <strong>Non appelé.</strong> Le service n'a obtenu aucune réponse de cet <code>Adapter</code>
        pour ce dossier — ce n'est pas un zéro : personne n'a encore cherché ici.
      </p>
    }
    else
    {
      <p class="hint">
        @locating.LastOutcome.FrenchLabel — appelé le
        @locating.AskedAt.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) sous
        @locating.DesignationsAtCall désignation@(locating.DesignationsAtCall > 1 ? "s" : null).
        @if (locating.DeclaredDeadline is { } deadline)
        {
          @*
            L'échéance est DÉCLARÉE par le client, jamais négociée. Le service repassera après elle —
            à la prochaine ouverture de ce dossier, et par aucune minuterie.
          *@
          <text>
            L'application déclare avoir fini le
            @deadline.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ; le service repassera à la
            prochaine ouverture de ce dossier, sans compter ses passages.
          </text>
        }
      </p>

      @if (locating.LastOutcome.IsRefusal)
      {
        <p class="refusal">
          <strong>Appel refusé.</strong> Le paysage déclaré et le programme qui le sert ne sont pas
          d'accord : rien n'a bougé dans ce dossier, et la tentative est datée dans la matière de
          preuve. Un humain tranchera lequel des deux avait tort.
        </p>
      }

      @if (locating.Certain.Count == 0)
      {
        <p class="none">Aucun rattachement certain.</p>
      }
      else
      {
        @*
          Le noyau certain, dans le VOCABULAIRE DE L'APPLICATION. Le service ne déréférence jamais ces
          mots : il ne saura jamais que « #1203 » est une ligne d'une table héritée.
        *@
        <p>Rattachements certains, dans les mots de l'application :</p>
        <ul class="certain">
          @foreach (var reference in locating.Certain)
          {
            <li><code>@reference.Value</code></li>
          }
        </ul>
      }

      @foreach (var reservation in locating.Reserved)
      {
        <div class="reservation">
          @*
            LA PROSE DE MOTIF, LUE TELLE QUELLE. C'est ce qui distingue cet écran d'une case à
            cocher : l'Operator lit POURQUOI l'application hésite, au lieu de cocher.
          *@
          <p class="reason">@reservation.Reason</p>

          <p class="hint">
            Référence de l'application : <code>@reservation.Reference.Value</code>
          </p>

          @if (reservation.Designations.Count == 0)
          {
            @*
              Sans désignation, la réserve reste LOCALE ET OPAQUE : quoi qu'on en arbitre, le service
              n'apprendra jamais ce que cette référence désignait, et aucun appel suivant n'en portera
              rien.
            *@
            <p class="hint">
              Cette réserve ne propose aucune désignation : elle reste <strong>locale à ce
              système</strong>. La trancher n'enrichira pas le sac, et les appels suivants ne
              porteront rien de plus.
            </p>
          }
          else
          {
            <p class="hint">
              Si vous la rattachez, ces désignations <strong>entrent au sac</strong> et l'appel suivant
              les portera :
            </p>
            <ul class="proposed">
              @foreach (var designation in reservation.Designations)
              {
                <li>@designation.Kind.FrenchLabel — @designation.Value</li>
              }
            </ul>
          }

          @if (!reservation.AwaitsAnArbitration)
          {
            <p class="settled">
              <strong>@reservation.State.FrenchLabel.</strong> Un humain a tranché ; la matière de
              preuve garde son nom et sa date.
            </p>
          }
          else
          {
            @*
              LES DEUX ISSUES SONT DEUX BOUTONS, et aucune n'est pré-sélectionnée. Une liste où
              « rattachée » serait cochée d'avance ferait fusionner à tort d'un seul clic — erreur
              irréversible, et portant sur la donnée d'un tiers.
            *@
            <form method="post" asp-page-handler="Arbitrate">
              <input type="hidden" name="Arbitration.DeclaredSystem" value="@located.DeclaredSystem.Value" />
              <input type="hidden" name="Arbitration.Reference" value="@reservation.Reference.Value" />

              <fieldset class="signature">
                <legend>Trancher cette réserve</legend>

                <p class="hint">
                  Le service ne tranche rien à votre place : ni la fusion à tort, irréversible et
                  portant sur la donnée d'un tiers, ni l'exclusion par prudence, qui ne laisserait
                  aucune trace. La preuve gardera le fait, votre nom et la date — jamais cette prose.
                </p>

                <p>
                  <label for="arbitrate-signedby-@located.DeclaredSystem.Value-@reservation.Reference.Value">
                    Votre nom
                    <span class="hint">
                      Saisi, et <strong>non authentifié</strong> : la preuve garde votre nom
                      <em>et</em> ce régime.
                    </span>
                  </label>
                  <input type="text"
                         id="arbitrate-signedby-@located.DeclaredSystem.Value-@reservation.Reference.Value"
                         name="Arbitration.SignedBy"
                         maxlength="@MicroserviceRgpd.Core.Casework.Ledger.Signatory.MaxNameLength" />
                </p>

                <button type="submit" name="Arbitration.Ruling" value="@ReservationState.Attached.Name">
                  C'est bien la personne
                </button>
                <button type="submit" name="Arbitration.Ruling" value="@ReservationState.SetAside.Name">
                  Ce n'est pas la personne
                </button>
              </fieldset>
            </form>
          }
        </div>
      }
    }
  </div>
}

<p><a asp-page="Queue">Revenir à la file</a></p>
