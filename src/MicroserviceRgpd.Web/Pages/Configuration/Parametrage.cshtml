@page "/parametrage"
@model ParametrageModel
@using MicroserviceRgpd.Core.Configuration
@{
  ViewData["Title"] = ParametrageFaces.ScreenName;

  // Les refus d'un envoi, dits dans la section du droit refusé — ou en tête d'écran quand le droit
  // envoyé n'est pas l'un des six. Le bloc lui-même est celui des deux faces.
  IReadOnlyList<string> Refusals() =>
    [.. ViewData.ModelState.Values.SelectMany(entry => entry.Errors).Select(refusal => refusal.ErrorMessage)];
}

<h1>@ParametrageFaces.ScreenName</h1>

<partial name="_ParametrageTabs" model="@ParametrageFaces.Http" />

@*
  La phrase dit ce que l'écran est : la configuration, droit par droit, de l'adresse à laquelle le
  service exercera chacun des six droits RGPD. Un droit sans adresse est « non configuré », et c'est
  l'état d'un service qu'on vient d'installer.
*@
<p class="caveat">
  Chacun des six droits ouverts par le RGPD porte l'adresse à laquelle le service l'exercera. Un
  droit sans adresse est <strong>« non configuré »</strong> : c'est un état normal, et rien ne vous
  oblige à les renseigner tous.
</p>

@if (!ViewData.ModelState.IsValid && Model.Refused is null)
{
  @* Un droit que l'écran ne configure pas n'a pas de section où dire son refus : il se dit ici. *@
  <partial name="_ParametrageRefusals" model="Refusals()" />
}

@foreach (var right in Model.Settings.Rights)
{
  var refused = right.Right == Model.Refused;
  var field = $"url-{right.Right.Name}";
  @* Cette page ne montre que l'espèce qu'elle configure : un droit réglé sur un routage RabbitMQ
     n'a pas d'adresse à afficher ici (ADR-0027). *@
  var address = right.Channel is ExerciseChannel.HttpEndpoint http ? http.Address.Value : null;

  <div class="right">
    <h2>@right.Right.FrenchLabel</h2>
    <dl>
      <dt>Article</dt>
      <dd>Article @right.Right.Article du RGPD</dd>

      <dt>Adresse d'exercice</dt>
      <dd>
        @if (address is not null)
        {
          @address
        }
        else
        {
          <span class="none">non configuré</span>
        }
      </dd>
    </dl>

    @if (refused)
    {
      <partial name="_ParametrageRefusals" model="Refusals()" />
    }

    @*
      Une mini-form par droit, qui n'envoie que lui. Le champ porte l'adresse déjà enregistrée —
      on la corrige sans repartir de zéro —, ou la saisie qui vient d'être refusée, pour qu'elle se
      corrige sans être retapée. Le champ est un texte, pas une `url` : c'est le service qui juge
      l'adresse, et son refus qui se lit — pas celui du navigateur, dans d'autres mots.
    *@
    <form method="post" asp-page-handler="Set">
      <input type="hidden" name="Form.Right" value="@right.Right.Name" />
      <p>
        <label for="@field">Adresse d'exercice du @right.Right.FrenchLabel</label>
        <input type="text" inputmode="url" id="@field" name="Form.Url"
               value="@(refused ? Model.Form.Url : address)" maxlength="@EndpointUrl.MaxLength" />
      </p>
      <button type="submit" class="primary">Enregistrer</button>
    </form>

    @*
      Effacer n'est offert qu'à un droit dont cette page montre le canal : un droit « non configuré »
      n'a rien à oublier. Sa propre form, qui n'envoie que le droit — pas l'adresse du champ voisin,
      qu'on aurait pu retoucher sans vouloir l'enregistrer. Le bouton n'est pas « destructif » : un
      droit sans adresse est un état normal, et l'adresse se ressaisit.
    *@
    @if (address is not null)
    {
      <form method="post" asp-page-handler="Clear">
        <input type="hidden" name="Form.Right" value="@right.Right.Name" />
        <button type="submit">Effacer</button>
      </form>
    }
  </div>
}
