@page "/parametrage/rabbitmq"
@model ParametrageRabbitMqModel
@using MicroserviceRgpd.Core.Configuration
@using MicroserviceRgpd.Infrastructure.Configuration
@{
  ViewData["Title"] = ParametrageFaces.ScreenName;

  // La liste et le détail côte à côte, comme sur la face HTTP.
  ViewData["Wide"] = true;

  // Les noms de liaison des deux champs : ce qui se range SOUS un champ, et donc ce qui ne se redit
  // pas dans le bloc de refus du détail.
  var exchangeName = $"{ParametrageRabbitMqModel.FormPrefix}.Exchange";
  var routingKeyName = $"{ParametrageRabbitMqModel.FormPrefix}.RoutingKey";

  // Les refus à dire en bloc — ceux qu'aucun champ ne porte. ⚠️ ON LES FILTRE PLUTÔT QUE DE NE LIRE
  // QUE LES DEUX CHAMPS CONNUS : un refus déposé sous un autre nom — le droit forgé d'aujourd'hui,
  // ce que le domaine ajouterait demain — serait autrement avalé en silence, et l'intégrateur
  // n'aurait jamais su pourquoi son envoi n'a pas été retenu.
  IReadOnlyList<string> Refusals(Func<string, bool> said) =>
    [.. ViewData.ModelState
         .Where(entry => said(entry.Key))
         .SelectMany(entry => entry.Value!.Errors)
         .Select(refusal => refusal.ErrorMessage)];

  // UN CHAMP DE LA MINI-FORM — son libellé, sa saisie, son aide, et le refus qui se range SOUS LUI.
  // Les deux champs se suivent dans un même fieldset : un refus laissé en tête du détail n'aurait
  // pas dit LEQUEL des deux corriger.
  //
  // ⚠️ PAS D'ATTRIBUT `maxlength`. Il compte des unités UTF-16, la contrainte des octets UTF-8 : un
  // navigateur qui tronquerait à 255 unités laisserait passer une valeur que le broker refuserait,
  // et en couperait une que le service accepte. LE SERVEUR FAIT FOI.
  void Field(string id, string name, string label, string hint, string? value, string? refusal)
  {
    var describedBy = refusal is null ? $"{id}-hint" : $"{id}-hint {id}-refusal";

    <p class="field">
      <label for="@id">@label</label>
      <input type="text" id="@id" name="@name" value="@value" autocomplete="off"
             aria-describedby="@describedBy" aria-invalid="@(refusal is null ? null : "true")" />
      <span class="hint" id="@($"{id}-hint")">@hint</span>
      @if (refusal is not null)
      {
        <span class="refusal" id="@($"{id}-refusal")">@refusal</span>
      }
    </p>
  }

  // Le refus déposé sous un champ, s'il y en a un et si c'est bien le droit qu'on saisissait.
  string? RefusalOf(bool refused, string field)
  {
    if (!refused)
    {
      return null;
    }

    var entry = ViewData.ModelState[field];

    return entry?.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
  }

  var right = Model.Selected;
  var refused = Model.Refused is not null;
  var routing = Model.Scene.Channel is ExerciseChannel.RabbitMq rabbitMq ? rabbitMq.Routing : null;

  // LE RÉGLAGE DE L'AUTRE FACE, LU ICI. Cette page ne configure que le routage, mais un droit réglé
  // en HTTP verrait son adresse remplacée par l'enregistrement d'un routage (ADR-0027) : c'est elle
  // qui décide de l'avertissement.
  var addressed = Model.Scene.Channel is ExerciseChannel.HttpEndpoint;
}

@*
  LE MÊME `h1` QUE LA FACE HTTP, et c'est ce qui fait lire les deux comme un seul écran à deux faces
  plutôt que comme deux écrans voisins. Il est écrit une fois, sur `ParametrageFaces`.
*@
<h1>@ParametrageFaces.ScreenName</h1>

<p class="lead">
  Choisissez un droit dans la liste, puis indiquez où le service doit l'exercer. Un droit sans canal
  reste <strong>« non configuré »</strong> : c'est normal.
</p>

@if (!ViewData.ModelState.IsValid && !refused)
{
  @* Un droit que l'écran ne configure pas n'a pas de détail où dire son refus : il se dit ici. *@
  <partial name="_ParametrageRefusals" model="Refusals(_ => true)" />
}

<div class="parametrage">
  <partial name="_ParametrageRights" model="Model.Scene" />

  <section class="right" aria-labelledby="right-title">
    <partial name="_ParametrageRightHead" model="Model.Scene" />

    <partial name="_ParametrageTabs" model="Model.Scene" />

    @*
      Une mini-form, qui n'envoie que le droit ouvert — ni « tout enregistrer », ni « tout effacer ».
      LES DEUX CHAMPS SONT RATTACHÉS À LEUR DROIT PAR LE `fieldset` ET SA `legend`, et non par une
      périphrase recopiée dans chaque libellé : « Exchange » et « Routing key » se lisent alors pour
      ce qu'ils sont, et le lecteur d'écran annonce le droit en entrant dans le groupe. La légende ne
      se voit pas : le titre du détail le dit déjà à qui regarde.
    *@
    <form method="post" asp-page-handler="Set">
      <input type="hidden" name="Form.Right" value="@right.Name" />

      @if (refused)
      {
        @* Les refus du détail qu'aucun des deux champs ne porte — le reste est sous son champ. *@
        <partial name="_ParametrageRefusals"
                 model="Refusals(key => key != exchangeName && key != routingKeyName)" />
      }

      <fieldset>
        <legend class="visually-hidden">Routage d'exercice du @right.FrenchLabel</legend>
        @{
          // Le champ porte le routage déjà enregistré — on le corrige sans repartir de zéro —, ou la
          // saisie qui vient d'être refusée, pour qu'elle se corrige sans être retapée.
          Field(
            "exchange",
            exchangeName,
            "Exchange",
            "Il doit déjà exister sur votre broker : le service ne le crée pas.",
            refused ? Model.Form.Exchange ?? string.Empty : routing?.Exchange.Value,
            RefusalOf(refused, exchangeName));

          Field(
            "routing-key",
            routingKeyName,
            "Routing key",
            "Vos bindings devront la reconnaître.",
            refused ? Model.Form.RoutingKey ?? string.Empty : routing?.RoutingKey.Value,
            RefusalOf(refused, routingKeyName));
        }
      </fieldset>

      @*
        LE BANDEAU DE CONNEXION — ce déploiement n'a aucune connexion RabbitMQ, et rien ne partira donc
        sur le bus quoi qu'on déclare ici. Il se lit sous les champs qu'il concerne, avant le bouton :
        lu après, il serait arrivé trop tard pour empêcher de croire le routage opérant.

        ⚠️ IL NE PARAÎT QUE S'IL CONCERNE L'INTÉGRATEUR — pas tant qu'aucun routage n'est posé. Un
        avertissement permanent sur un écran qu'on vient d'ouvrir devient un meuble, et on cesse de le
        lire le jour où il dit quelque chose.

        ⚠️ IL NOMME LA CLÉ, et c'est ce qui le rend actionnable. Elle se lit sur la constante de la
        connexion déclarée au déploiement, jamais recopiée ici — et elle se pose dans la configuration
        du déploiement, jamais depuis cet écran, qui ne détient aucun secret.

        ⚠️ IL NE PARAÎT JAMAIS SUR LA FACE HTTP : un avertissement RabbitMQ n'a rien à dire d'un écran
        qui ne parle pas de RabbitMQ. C'est pour cela qu'il vit dans CE gabarit et non dans le layout.
      *@
      @if (Model.WarnsThatNothingWillBePublished)
      {
        <div class="advisory" role="note">
          <partial name="_WarningIcon" />
          <p>
            <strong>Aucune connexion RabbitMQ sur ce déploiement</strong> : les routages sont
            enregistrés, mais rien ne partira tant que <code>@RabbitMqOptions.HostNameKey</code> n'est
            pas renseigné dans la configuration du déploiement.
          </p>
        </div>
      }

      @*
        ⚠️ L'AVERTISSEMENT PRÉCÈDE LE BOUTON, et il NOMME le réglage qui sera remplacé. Il ne paraît
        que pour un droit réglé sur l'autre face : un droit « non configuré » n'a rien à perdre, et un
        droit déjà routé ne remplace que le sien.
      *@
      @if (addressed)
      {
        <p class="replacement">
          <partial name="_WarningIcon" />
          <span>Enregistrer un routage remplacera l'adresse HTTP actuelle : un droit ne porte qu'un seul canal.</span>
        </p>
      }

      <div class="actions">
        <button type="submit" class="primary">Enregistrer</button>

        @*
          Effacer n'est offert qu'à un droit que cette page CONFIGURE : un droit « non configuré » n'a
          rien à oublier, et un droit réglé en HTTP — dont cette page montre l'adresse sans l'écrire —
          n'a pas à voir son réglage détruit par le bouton d'une face qui ne le configure pas. Le
          bouton envoie SA PROPRE form, qui ne porte que le droit — pas les champs voisins, qu'on
          aurait pu retoucher sans vouloir les enregistrer.
        *@
        @if (routing is not null)
        {
          <button type="submit" form="clear">Effacer le canal</button>
        }
      </div>
    </form>

    @if (routing is not null)
    {
      <form id="clear" method="post" asp-page-handler="Clear">
        <input type="hidden" name="Form.Right" value="@right.Name" />
      </form>
    }
  </section>
</div>
