@page "/detection/archive/table"
@model MicroserviceRgpd.Web.Pages.Screenings.ArchivedTableModel
@{
  var answer = Model.Answer!;
  var read = answer.Content;
  var clause = answer.Clause;

  ViewData["Title"] = $"La table {read.Identity} d'un rapport de détection archivé";

  @*
    L'EXCEPTION DE LARGEUR, réclamée par le motif, exactement comme sur l'écran d'arbitrage : un
    motif replié est un motif qui n'existe plus, et c'est ce qui permet de RELIRE ce qui avait été
    tranché — ou de comprendre pourquoi ça ne l'a pas été.
  *@
  ViewData["Wide"] = true;

  string Counted(int count, string noun) => count == 1 ? $"{count} {noun}" : $"{count} {noun}s";
}

<h1>@read.Identity</h1>

@*
  CE QUE CET ÉCRAN EST, EN TÊTE. Il a la même allure que l'écran d'arbitrage, aux boutons près :
  sans cette phrase, on cherche les boutons plutôt que de comprendre qu'il n'y en a pas.
*@
<p class="caveat">
  Cette table appartient à un rapport de détection <strong>archivé</strong>, lancé le
  @read.LaunchedOn.ToString("dd/MM/yyyy à HH:mm", System.Globalization.CultureInfo.GetCultureInfo("fr-FR")).
  Elle se lit en entier — <strong>toutes</strong> ses colonnes, et les arbitrages qu'elle portait —
  et elle ne s'arbitre plus.
</p>

<dl class="banner">
  <dt>Base</dt>
  <dd>@read.Database</dd>
  <dt>SGBD</dt>
  <dd>@read.Dialect</dd>
  <dt>Commentaire de la table</dt>
  @if (read.Comment is null)
  {
    <dd class="none">Aucun — votre SGBD n'en rend pas, ou cette table n'en portait pas.</dd>
  }
  else
  {
    <dd>@read.Comment</dd>
  }
</dl>

@*
  TOUTES LES COLONNES, SANS FILTRE, ET DANS L'ORDRE DU RELEVÉ — la même règle que sur le courant.
  Un archivé amputé de ses colonnes non signalées serait un rapport de détection dont personne ne
  peut plus vérifier ce que la détection n'avait pas vu.
*@
<p class="hint">
  Les <strong>@Counted(read.ColumnCountInThisTable, "colonne")</strong> de cette table sont ici, dans
  l'ordre où votre base les rendait — celles où la détection n'avait rien vu comprises.
</p>

<table class="queue columns">
  <caption>
    Dans cette table : @Counted(read.ColumnCountInThisTable, "colonne"), dont
    @read.FlaggedCountInThisTable signalée@(read.FlaggedCountInThisTable == 1 ? "" : "s") —
    @read.NeverArbitratedInThisTable n'@(read.NeverArbitratedInThisTable == 1 ? "a" : "ont") jamais été tranchée@(read.NeverArbitratedInThisTable == 1 ? "" : "s")
  </caption>
  <thead>
    <tr>
      <th scope="col">Colonne</th>
      <th scope="col">Type</th>
      <th scope="col">Catégorie</th>
      <th scope="col">Règle</th>
      <th scope="col" class="reason">Motif</th>
      <th scope="col" class="ruling">Arbitrage</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var column in read.Columns)
    {
      <tr>
        <th scope="row">
          @column.Identity.Column
          @if (column.Listed.ColumnComment is not null)
          {
            <span class="hint">@column.Listed.ColumnComment</span>
          }
        </th>
        <td>@(column.Listed.DataType ?? "—")</td>
        @if (column.IsFlagged)
        {
          <td>@column.Category.FrenchLabel</td>
          <td>
            @column.Strength!.FrenchLabel
            <span class="hint">@column.Strength.Rule</span>
          </td>
          @* LE MOTIF, EN CLAIR ET EN ENTIER — il est ce sur quoi l'arbitrage d'alors s'est fait. *@
          <td class="reason">@column.Reason</td>
        }
        else
        {
          @* ⚠️ Rien n'avait été vu — un constat sur la DÉTECTION, jamais sur la donnée. Aucun motif :
             il n'y a rien à motiver. *@
          <td class="none">Rien n'a été vu</td>
          <td></td>
          <td class="reason"></td>
        }
        <td class="ruling">
          @*
            ⚠️ AUCUN FORMULAIRE ICI, et c'est tout ce qui distingue cette cellule de sa jumelle. La
            signature d'alors se lit ; elle ne se reprend pas.
          *@
          @if (column.AwaitsAnArbitration)
          {
            <span class="none">Jamais tranchée</span>
          }
          else
          {
            @column.Arbitration!.State.FrenchLabel
            <span class="hint">
              @column.Arbitration.SignedBy, le
              @column.Arbitration.SignedOn.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))
            </span>
          }
        </td>
      </tr>
    }
  </tbody>
</table>

<h2>Les comptes de ce rapport de détection archivé</h2>

<dl class="banner tally">
  <dt>Signalées</dt>
  <dd>@read.Tally.Flagged</dd>
  <dt>Retenues</dt>
  <dd>@read.Tally.Retained</dd>
  <dt>Écartées</dt>
  <dd>@read.Tally.SetAside</dd>
  <dt>Jamais tranchées</dt>
  <dd>@read.Tally.Awaiting</dd>
  <dt>Retenues sur « rien signalé »</dt>
  <dd>@read.Tally.RetainedOnUnflagged</dd>
</dl>

<partial name="_IncompletenessClause" model="clause" />

<p>
  <a asp-page="Archive" asp-route-screening="@read.Screening.Value">Revenir à ce rapport de détection archivé</a> —
  <a asp-page="History">l'historique des rapports de détection</a>
</p>
