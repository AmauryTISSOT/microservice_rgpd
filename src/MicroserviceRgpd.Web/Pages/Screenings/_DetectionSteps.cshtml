@model MicroserviceRgpd.Web.Pages.Screenings.DetectionStep
@using MicroserviceRgpd.Web.Pages.Screenings

@*
  LES TROIS TEMPS DU PARCOURS, et celui où l'on est. Sans eux, l'arbitrage se lit comme un écran
  sans fin : rien ne dit qu'il y a un après, ni ce qu'on y fait.

  ⚠️ LE PREMIER TEMPS N'EST PAS UN LIEN. Refaire un relevé produit un rapport neuf et range celui-ci
  dans l'historique sans reprendre un seul arbitrage : ce coût est dit à côté des liens qui l'offrent,
  au pied du rapport, et un clic sur une pastille d'étape ne doit pas pouvoir y mener sans l'avoir lu.

  ⚠️ L'EXPORT RESTE ATTEIGNABLE AVANT LA FIN. Le fichier porte aussi les lignes en attente, et c'est
  l'écran de l'export qui dit combien — pas une étape verrouillée qui l'aurait tu.
*@
<ol class="detection-steps" aria-label="Le parcours de la détection">
  <li class="done">
    <span class="detection-step-mark" aria-hidden="true">✓</span>
    <span>Relever le schéma</span>
  </li>
  <li class="@(Model == DetectionStep.Arbitration ? "current" : "done")">
    <span class="detection-step-mark" aria-hidden="true">@(Model == DetectionStep.Export ? "✓" : "2")</span>
    @if (Model == DetectionStep.Arbitration)
    {
      <span aria-current="step">Arbitrer les colonnes</span>
    }
    else
    {
      <a asp-page="Report">Arbitrer les colonnes</a>
    }
  </li>
  <li class="@(Model == DetectionStep.Export ? "current" : null)">
    <span class="detection-step-mark" aria-hidden="true">3</span>
    @if (Model == DetectionStep.Export)
    {
      <span aria-current="step">Exporter</span>
    }
    else
    {
      <a asp-page="Export">Exporter</a>
    }
  </li>
</ol>
