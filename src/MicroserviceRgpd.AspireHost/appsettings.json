{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },

  // Les réglages du moteur LLM du sidecar. Aucun n'est mesuré : ils sont arbitraires et assumés,
  // et devront être révisés le jour où le modèle tournera sous charge. Les tenir ici est ce qui
  // permettra cette révision sans rouvrir une ligne de code Python.
  //
  // `SidecarDeadlineSeconds` doit rester **strictement plus courte** que `CallerDeadlineSeconds` :
  // c'est cet écart qui fait que le sidecar abandonne le premier et sait nommer la lenteur, là où
  // l'appelant .NET n'aurait qu'une échéance anonyme à rapporter. Le sidecar refuse de démarrer
  // si l'inégalité n'est pas tenue.
  //
  // Passer à un autre fournisseur compatible OpenAI ne demande que `Model` et l'adresse du
  // serveur — celle-ci venant de la ressource Ollama déclarée dans l'AppHost.
  "Llm": {
    // L'existence du moteur, et l'unique vérité du drapeau sous Aspire : l'AppHost le propage au
    // service .NET et au sidecar, qui ne peuvent donc pas diverger. **Absent, il vaut « éteint »** —
    // seul réglage de la section à disposer d'un repli, et ce repli est ce qui fait démarrer la pile
    // entière sur un poste sans carte graphique, sans tirer les quelques gigaoctets du modèle.
    // Allumé, le serveur de modèles entre dans la pile et tous les réglages ci-dessous s'appliquent ;
    // éteint, aucun n'est lu — les laisser écrits est ce qui fait de rallumer un seul mot à changer.
    "Enabled": "false",
    "Model": "qwen3:8b",
    // Ollama ne vérifie aucune clé ; un fournisseur qui la vérifie mérite un secret utilisateur,
    // et surtout pas ce fichier versionné.
    "ApiKey": "ollama-ne-lit-pas-cette-cle",
    "Temperature": "0",
    "Seed": "20180525",
    "SidecarDeadlineSeconds": "120",
    "CallerDeadlineSeconds": "150"
  },

  // Ce qui ne dépend pas du moteur LLM. L'échéance du client lexical n'a aucun amont derrière elle,
  // donc aucune inégalité à tenir : elle répond à une seule propriété, le témoin ne doit jamais
  // rallonger le temps de réponse du service. Arbitraire et assumée, comme les autres.
  "Qualification": {
    "LexiconDeadlineSeconds": "5"
  },

  // Le secret partagé que le service présente à chaque `Adapter` du client, en en-tête
  // « X-RGPD-Secret ». Il est **de la topologie** — un par `Adapter`, jamais par `system_id` — et il
  // ne vit jamais dans le `Manifest`, qui se relit à l'écran.
  //
  // Celui-ci est un secret de développement dans un fichier versionné, et il ne trompe personne :
  // il n'ouvre que le témoin lancé sur ce poste. Un déploiement en pose un à lui, hors de tout
  // fichier suivi — la même règle que `Llm:ApiKey` quelques lignes plus haut.
  //
  // **Un seul secret est valide** : la rotation est un redémarrage coordonné des deux côtés, sans
  // recouvrement. Absent, le service refuse de démarrer.
  "Casework": {
    "AdapterSecret": "secret-de-developpement-jamais-un-vrai"
  }
}
